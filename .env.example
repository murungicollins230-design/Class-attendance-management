# Copy this file to ".env" and adjust the values to match your MySQL setup.
# The project ships with database\start-database.cmd, which runs a dedicated
# MySQL instance on port 3307 (user: root, empty password).

# Server
PORT=3000

# MySQL database (live database connection)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=swe2106_attendance
